@startuml 06-example3
start
partition #lightGreen "ввод" {
    - Ввод количества строк (n)
    - Ввод количества столбцов (m)
}
partition #lightPink "управление памятью" {
    - Выделить память под указатели на строки матрицы arr
    while (i = 0; i < n; i++)
        - Выделить память под элементы строки матрицы arr[i]
    endwhile
}
partition #lightGray "вычисления" {
    while (i = 0; i < n; i++)
        while (j = 0; j < m; j++)
            if (i < j?) then
                - arr[i][j] = j
            else (да)
                - arr[i][j] = i
            endif
        endwhile
    endwhile
}
partition #lightGreen "вывод" {
    while (i = 0; i < n; i++)
        while (j = 0; j < m; j++)
            - Вывод элемента матрицы arr[i][j]
        endwhile
    endwhile
}
partition #lightPink "управление памятью" {
    while (i = 0; i < n; i++)
        - Освободить память вектора элементов строки матрицы arr[i]
    endwhile
    - Освободить память вектора указателей на строки матрицы arr
}
stop
@enduml
