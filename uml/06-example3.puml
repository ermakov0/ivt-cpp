- Ввод количества столбцов (m)

- Выделить память под указатели на строки матрицы arr
while (i = 0; i < n; i++)
    - Выделить память под элементы строки матрицы arr[i]
endwhile

while (i = 0; i < n; i++)
    while (j = 0; j < m; j++)
        if (i < j?) then
            - arr[i][j] = j
        else (да)
            - arr[i][j] = i
        endif
