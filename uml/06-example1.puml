@startuml 06-example1
start
partition #lightGreen "ввод" {
    - Ввод количества строк (n)
    - Ввод количества столбцов (m)
    if (n > MAX_SIZE или m > MAX_SIZE?) then
    else (да)
        stop
    endif
}
partition #lightGray "вычисления" {
    while (i = 0; i < n; i++)
        while (j = 0; j < m; j++)
            if (i < j?) then
                - arr[i][j] = j
            else (да)
                - arr[i][j] = i
            endif
        endwhile
    endwhile
}
partition #lightGreen "вывод" {
    while (i = 0; i < n; i++)
        while (j = 0; j < m; j++)
            - Вывод элемента матрицы arr[i][j]
        endwhile
    endwhile
}
